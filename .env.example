# Used by docker-compose.yml. Copy to .env (gitignored) and fill in. Names only here: never commit real values.
# The non-Docker server reads backend/.env instead (see backend/.env.example).

# ---- REQUIRED (compose refuses to start without them) ----
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Optional (defaults in docker-compose.yml) ----
POSTGRES_USER=
POSTGRES_DB=
APP_ENV=
LOG_LEVEL=
CORS_ORIGINS=
PUBLIC_API_URL=
API_PORT=
FRONTEND_PORT=
ADMIN_NAME=
ACCESS_TOKEN_MINUTES=
REFRESH_TOKEN_DAYS=
RUN_MIGRATIONS=
SCHEDULER_ENABLED=
SCAN_INTERVAL_MINUTES=

# ---- Optional data sources and extras ----
TAVILY_API_KEY=
TAVILY_MONTHLY_BUDGET=
SEARXNG_BASE_URL=
GEMINI_API_KEY=
SCAM_LLM_ENABLED=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
INSTALL_EXTRAS=
